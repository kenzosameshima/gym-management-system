APP_NAME=Gym Management System API
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://gym_user:replace-password@postgres:5432/gym_management
BACKEND_CORS_ORIGINS=https://app.example.com
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional first-admin seed. Provide all three only during first deployment.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_FULL_NAME=Admin User
# INITIAL_ADMIN_PASSWORD=replace-with-a-unique-temporary-password
SEED_DEFAULT_PLANS=false
